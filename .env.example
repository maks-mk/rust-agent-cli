# API key of an OpenAI-compatible API. Required for api.openai.com,
# optional for local servers such as Ollama.
OPENAI_API_KEY=your_api_key_here
# Base URL of the OpenAI-compatible API.
OPENAI_BASE_URL=https://api.openai.com/v1
# Model to use; it must support tool calling.
OPENAI_MODEL=gpt-4o-mini
# API endpoint mode: chat uses /chat/completions; responses uses /responses.
# Missing/empty defaults to chat; accepted values are chat or responses.
API_MODE=chat
# Reasoning effort for reasoning models (e.g. low, medium, high).
# Empty means the field is not sent; API_MODE determines its wire format.
REASONING_EFFORT=
# Reasoning levels cycled with Ctrl+Tab, separated by commas.
# The token `off` means the parameter is not sent at all.
# Empty falls back to none,minimal,low,medium,high,xhigh,max.
# Which levels a model accepts depends on the provider.
REASONING_EFFORTS=none,minimal,low,medium,high,xhigh,max
# Maximum number of tool steps per turn (default: 25)
# Invalid or zero values are ignored and 25 is used.
AGENT_MAX_STEPS=25
# Context compression threshold in tokens (100000 = 100k; 0 disables)
# Invalid values fall back to 100000.
AGENT_CONTEXT_TOKENS=100000
# Initial auto-approval for writes, shell commands and MCP tool calls.
# on/off (also true/false, 1/0, yes/no); case-insensitive.
# Missing, empty or invalid values mean off. /auto toggles it for the session.
# MCP server startup still requires separate session trust.
AGENT_AUTO_APPROVE=off
# Set to any value to force the ASCII-only UI.
# RUST_AGENT_ASCII=1
