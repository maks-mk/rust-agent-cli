{
  "context7": {
    "type": "remote",
    "url": "https://mcp.context7.com/mcp",
    "transport": "http",
    "enabled": true,
    "policy": {
      "read_only": true
    }
  },
  "ddg-search": {
    "command": "uvx",
    "args": [
      "--with",
      "duckduckgo-mcp-server[browser]",
      "duckduckgo-mcp-server"
    ],
    "transport": "stdio",
    "enabled": true,
    "policy": {
      "read_only": true
    }
  }
}
